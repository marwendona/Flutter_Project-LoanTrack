      "name": "borrowers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"borrowers\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"name_key\" TEXT NOT NULL UNIQUE, \"phone\" TEXT NULL, \"note\" TEXT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "loans",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"loans\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"borrower_id\" INTEGER NOT NULL REFERENCES borrowers (id) ON DELETE CASCADE, \"amount_minor\" INTEGER NOT NULL CHECK(\"amount_minor\" > 0), \"loan_date\" INTEGER NOT NULL, \"promised_return_date\" INTEGER NULL, \"note\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "repayments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"repayments\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"loan_id\" INTEGER NOT NULL REFERENCES loans (id) ON DELETE CASCADE, \"amount_minor\" INTEGER NOT NULL CHECK(\"amount_minor\" > 0), \"repayment_date\" INTEGER NOT NULL, \"note\" TEXT NULL);"
        }
      ]
    },
